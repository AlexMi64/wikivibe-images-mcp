{
  "name": "wikivibe-images-mcp",
  "version": "0.1.1",
  "description": "Generate and edit images through WikiVibe from any MCP-capable agent (OMP, Claude Code, Codex, Cursor, opencode)",
  "type": "module",
  "bin": {
    "wikivibe-images": "dist/cli.js",
    "wikivibe-images-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "wikivibe",
    "image-generation",
    "ai",
    "codex",
    "claude-code",
    "omp"
  ],
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/cli.js",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "prepack": "npm run typecheck && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "zod": "^3.25.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexMi64/wikivibe-images-mcp.git"
  },
  "homepage": "https://github.com/AlexMi64/wikivibe-images-mcp#readme",
  "bugs": {
    "url": "https://github.com/AlexMi64/wikivibe-images-mcp/issues"
  },
  "dependencies": {}
}
